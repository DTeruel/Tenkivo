{
  "productName": "Tenkivo",
  "version": "0.14.7",
  "identifier": "studio.gamedesign.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
